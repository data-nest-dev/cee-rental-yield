{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "recordType": {
                "type": "string",
                "title": "Record type",
                "description": "`scoredListing` (an apartment for sale), `areaYield` (a district × room group) or `listing` (mode listings: a flat for sale or for rent). Both scoredListing and areaYield can appear in the default dataset when mode is yieldReport.",
                "enum": [
                    "scoredListing",
                    "areaYield",
                    "listing"
                ]
            },
            "source": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Source",
                "description": "Portal the listing comes from.",
                "example": "otodom"
            },
            "listingId": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Listing ID",
                "description": "Portal's listing ID."
            },
            "url": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Listing URL",
                "description": "Link to the listing on the portal."
            },
            "country": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Country",
                "description": "ISO country code.",
                "example": "PL"
            },
            "city": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "City",
                "description": "City name.",
                "example": "Kraków"
            },
            "district": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "District",
                "description": "District name; null when the portal gives none."
            },
            "rooms": {
                "type": [
                    "integer",
                    "string",
                    "null"
                ],
                "title": "Rooms",
                "description": "Room count of a listing (number), or the room group of a yield record (`1`, `2`, `3`, `4+`)."
            },
            "areaM2": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Area (m²)",
                "description": "Listing area in square metres."
            },
            "isPrimaryMarket": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "New build",
                "description": "True when the portal links the flat to a development, false when resales only were requested, null when unknown."
            },
            "price": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Price",
                "description": "Asking price: `local` amount, `currency` and `eur` (ECB daily rate)."
            },
            "pricePerM2Eur": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Price per m² (EUR)",
                "description": "Asking price per m² in EUR."
            },
            "groupMedianPricePerM2Eur": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Group median price per m² (EUR)",
                "description": "Median asking price per m² of the comparison group."
            },
            "dealScore": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Deal score",
                "description": "0–100; 50 = priced at the group median, higher = cheaper than comparable flats."
            },
            "discountVsMedianPct": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Below median (%)",
                "description": "How far the price per m² is below the group median, in percent. Negative values mean the price is above the median."
            },
            "estimatedRentMonthlyEur": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Estimated rent (EUR/month)",
                "description": "Median rent per m² of the comparison group × the flat's area."
            },
            "grossYieldPct": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Gross yield (%)",
                "description": "Annual gross rental yield: for a listing from its estimated rent, for a yield record from group medians."
            },
            "saleGroupLevel": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Price compared at",
                "description": "Comparison level for the sale price: `district`, `city_rooms` or `city`."
            },
            "rentGroupLevel": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Rent compared at",
                "description": "Comparison level for the rent estimate: `district`, `city_rooms` or `city`; null when no rent estimate."
            },
            "confidence": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Confidence",
                "description": "`high`, `medium` or `low`, from the sample size and comparison level."
            },
            "daysOnMarket": {
                "type": [
                    "integer",
                    "null"
                ],
                "title": "Days on market",
                "description": "Days since the portal first published the listing."
            },
            "flags": {
                "type": [
                    "array",
                    "null"
                ],
                "title": "Flags",
                "description": "Reasons to check the listing: `needsRenovation`, `suspectRooms` (room count looks wrong for the area; the listing is compared at city level only).",
                "items": {
                    "type": "string"
                }
            },
            "identicalListingIds": {
                "type": [
                    "array",
                    "null"
                ],
                "title": "Identical listings",
                "description": "Other listings with the same district, rooms, area and price, e.g. identical units of one development.",
                "items": {
                    "type": "string"
                }
            },
            "firstSeenAt": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "First seen",
                "description": "Monitoring: date the listing was first seen."
            },
            "changeType": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Change",
                "description": "Monitoring: `new`, `priceCut` or `unchanged`; null without monitoring."
            },
            "priceCutPct": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Price cut (%)",
                "description": "Monitoring: size of the price cut since the last run."
            },
            "groupLevel": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Compared at",
                "description": "Yield records: comparison level used (`district`, `city_rooms`, `city`)."
            },
            "saleCount": {
                "type": [
                    "integer",
                    "null"
                ],
                "title": "Sale listings",
                "description": "Yield records: number of sale listings behind the group."
            },
            "rentCount": {
                "type": [
                    "integer",
                    "null"
                ],
                "title": "Rent listings",
                "description": "Yield records: number of rental listings behind the group."
            },
            "salePricePerM2Eur": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Sale price per m² (EUR)",
                "description": "Yield records: `median`, `p25`, `p75`."
            },
            "rentPerM2MonthlyEur": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Rent per m² per month (EUR)",
                "description": "Yield records: `median`, `p25`, `p75`."
            },
            "grossYieldRangePct": {
                "type": [
                    "array",
                    "null"
                ],
                "title": "Gross yield range (%)",
                "description": "Yield records: [low, high] from the quartiles.",
                "items": {
                    "type": [
                        "number",
                        "null"
                    ]
                }
            },
            "local": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Local currency",
                "description": "Yield records: currency and medians in the local currency."
            },
            "fx": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Exchange rate",
                "description": "Yield records: ECB rate used (`source`, `date`, `eurToLocal`)."
            },
            "priceBasis": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Price basis",
                "description": "Always `asking`."
            },
            "sample": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Sample",
                "description": "Yield records: age and share of the sample (`sale`, `rent`). `share` = fetched / `reachableItems`; `reachableItems` = the portal total minus `primaryMarketUnits` (flats inside development tiles, which the list shows as one tile each), never below the number fetched."
            },
            "sources": {
                "type": [
                    "array",
                    "null"
                ],
                "title": "Sources",
                "description": "Yield records: portals used.",
                "items": {
                    "type": "string"
                }
            },
            "computedAt": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Computed at",
                "description": "Yield records: UTC timestamp."
            },
            "transaction": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Transaction",
                "description": "`sale` or `rent` (mode listings)."
            },
            "estimatedMonthlyRentPln": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Estimated rent (PLN/month)",
                "description": "Mode listings, sale rows: median rent per m² of the comparable group × the flat's area, rounded to 10 PLN. Null when the group has low confidence or too few rentals (see estimateNote)."
            },
            "estimatedMonthlyRentEur": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Estimated rent (EUR/month)",
                "description": "Mode listings, sale rows: the same estimate in EUR (ECB daily rate). In other modes, see estimatedRentMonthlyEur."
            },
            "estimatedGrossYieldPct": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Estimated gross yield %",
                "description": "Mode listings, sale rows: 12 × estimatedMonthlyRentPln ÷ asking price × 100."
            },
            "estimateNote": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Estimate note",
                "description": "Why the rent and yield estimates are null, if they are."
            },
            "comparable": {
                "type": [
                    "object",
                    "null"
                ],
                "title": "Comparable group",
                "description": "Mode listings, sale rows: the group the deal score and estimate are based on (`groupLevel`, `rentGroupLevel`, `district`, `rooms`, `confidence`, `saleCount`, `rentCount`)."
            },
            "monthlyRentPerM2Eur": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Rent per m² (EUR/month)",
                "description": "Mode listings, rent rows: monthly rent per m² in EUR."
            }
        },
        "additionalProperties": true
    },
    "views": {
        "overview": {
            "title": "Scored listings",
            "description": "Apartments for sale, best deal first (scoredListing records).",
            "transformation": {
                "fields": [
                    "dealScore",
                    "discountVsMedianPct",
                    "price.local",
                    "price.eur",
                    "pricePerM2Eur",
                    "city",
                    "district",
                    "rooms",
                    "areaM2",
                    "estimatedRentMonthlyEur",
                    "grossYieldPct",
                    "url",
                    "flags"
                ],
                "flatten": [
                    "price"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "dealScore": {
                        "label": "Deal score",
                        "format": "number"
                    },
                    "discountVsMedianPct": {
                        "label": "Below median %",
                        "format": "number"
                    },
                    "price.local": {
                        "label": "Price (local currency)",
                        "format": "number"
                    },
                    "price.eur": {
                        "label": "Price (EUR)",
                        "format": "number"
                    },
                    "pricePerM2Eur": {
                        "label": "EUR/m²",
                        "format": "number"
                    },
                    "city": {
                        "label": "City",
                        "format": "text"
                    },
                    "district": {
                        "label": "District",
                        "format": "text"
                    },
                    "rooms": {
                        "label": "Rooms",
                        "format": "number"
                    },
                    "areaM2": {
                        "label": "Area m²",
                        "format": "number"
                    },
                    "estimatedRentMonthlyEur": {
                        "label": "Est. rent EUR/month",
                        "format": "number"
                    },
                    "grossYieldPct": {
                        "label": "Gross yield %",
                        "format": "number"
                    },
                    "url": {
                        "label": "Listing",
                        "format": "link"
                    },
                    "flags": {
                        "label": "Flags",
                        "format": "array"
                    }
                }
            }
        },
        "listings": {
            "title": "Listings",
            "description": "Mode listings: every flat for sale and for rent, sale rows best deal first.",
            "transformation": {
                "fields": [
                    "transaction",
                    "city",
                    "district",
                    "rooms",
                    "areaM2",
                    "price.local",
                    "price.eur",
                    "pricePerM2Eur",
                    "dealScore",
                    "estimatedMonthlyRentPln",
                    "estimatedGrossYieldPct",
                    "url"
                ],
                "flatten": [
                    "price"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "transaction": {
                        "label": "Sale / rent",
                        "format": "text"
                    },
                    "city": {
                        "label": "City",
                        "format": "text"
                    },
                    "district": {
                        "label": "District",
                        "format": "text"
                    },
                    "rooms": {
                        "label": "Rooms",
                        "format": "number"
                    },
                    "areaM2": {
                        "label": "Area m²",
                        "format": "number"
                    },
                    "price.local": {
                        "label": "Price (local currency)",
                        "format": "number"
                    },
                    "price.eur": {
                        "label": "Price (EUR)",
                        "format": "number"
                    },
                    "pricePerM2Eur": {
                        "label": "EUR/m²",
                        "format": "number"
                    },
                    "dealScore": {
                        "label": "Deal score",
                        "format": "number"
                    },
                    "estimatedMonthlyRentPln": {
                        "label": "Est. rent PLN/month",
                        "format": "number"
                    },
                    "estimatedGrossYieldPct": {
                        "label": "Est. gross yield %",
                        "format": "number"
                    },
                    "url": {
                        "label": "Listing",
                        "format": "link"
                    }
                }
            }
        },
        "yields": {
            "title": "Rental yield by district",
            "description": "One row per district and room group (areaYield records). Filled only when mode is yieldReport; otherwise see the yields dataset.",
            "transformation": {
                "fields": [
                    "city",
                    "district",
                    "rooms",
                    "grossYieldPct",
                    "salePricePerM2Eur.median",
                    "rentPerM2MonthlyEur.median",
                    "saleCount",
                    "rentCount",
                    "confidence",
                    "groupLevel",
                    "local.currency",
                    "fx.date"
                ],
                "flatten": [
                    "salePricePerM2Eur",
                    "rentPerM2MonthlyEur",
                    "local",
                    "fx"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "city": {
                        "label": "City",
                        "format": "text"
                    },
                    "district": {
                        "label": "District",
                        "format": "text"
                    },
                    "rooms": {
                        "label": "Rooms",
                        "format": "text"
                    },
                    "grossYieldPct": {
                        "label": "Gross yield %",
                        "format": "number"
                    },
                    "salePricePerM2Eur.median": {
                        "label": "Median sale EUR/m²",
                        "format": "number"
                    },
                    "rentPerM2MonthlyEur.median": {
                        "label": "Median rent EUR/m²/month",
                        "format": "number"
                    },
                    "saleCount": {
                        "label": "Sale listings",
                        "format": "number"
                    },
                    "rentCount": {
                        "label": "Rent listings",
                        "format": "number"
                    },
                    "confidence": {
                        "label": "Confidence",
                        "format": "text"
                    },
                    "groupLevel": {
                        "label": "Compared at",
                        "format": "text"
                    },
                    "local.currency": {
                        "label": "Local currency",
                        "format": "text"
                    },
                    "fx.date": {
                        "label": "ECB rate date",
                        "format": "text"
                    }
                }
            }
        }
    }
}
