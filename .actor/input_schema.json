{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "Rental Yield & Deal Score",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "cities": {
            "title": "Cities",
            "type": "array",
            "description": "Cities to analyse. Each city samples apartments for sale and for long-term rent.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": ["warszawa", "krakow", "wroclaw", "katowice"],
                "enumTitles": ["Warsaw", "Kraków", "Wrocław", "Katowice"]
            },
            "minItems": 1,
            "default": ["warszawa", "krakow"]
        }
    }
}
