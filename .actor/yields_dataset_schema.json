{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "views": {
        "yields": {
            "title": "Rental yield by district",
            "description": "One row per district and room group (areaYield records).",
            "transformation": {
                "fields": [
                    "city",
                    "district",
                    "rooms",
                    "grossYieldPct",
                    "salePricePerM2Eur.median",
                    "rentPerM2MonthlyEur.median",
                    "saleCount",
                    "rentCount",
                    "confidence",
                    "groupLevel",
                    "local.currency",
                    "fx.date"
                ],
                "flatten": [
                    "salePricePerM2Eur",
                    "rentPerM2MonthlyEur",
                    "local",
                    "fx"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "city": {
                        "label": "City",
                        "format": "text"
                    },
                    "district": {
                        "label": "District",
                        "format": "text"
                    },
                    "rooms": {
                        "label": "Rooms",
                        "format": "text"
                    },
                    "grossYieldPct": {
                        "label": "Gross yield %",
                        "format": "number"
                    },
                    "salePricePerM2Eur.median": {
                        "label": "Median sale EUR/m²",
                        "format": "number"
                    },
                    "rentPerM2MonthlyEur.median": {
                        "label": "Median rent EUR/m²/month",
                        "format": "number"
                    },
                    "saleCount": {
                        "label": "Sale listings",
                        "format": "number"
                    },
                    "rentCount": {
                        "label": "Rent listings",
                        "format": "number"
                    },
                    "confidence": {
                        "label": "Confidence",
                        "format": "text"
                    },
                    "groupLevel": {
                        "label": "Compared at",
                        "format": "text"
                    },
                    "local.currency": {
                        "label": "Local currency",
                        "format": "text"
                    },
                    "fx.date": {
                        "label": "ECB rate date",
                        "format": "text"
                    }
                }
            }
        }
    }
}
